        "import heapq\n",
        "file=open('/content/Arad 366 Zerind 75 Timisoara 118 Si.txt', 'r')\n",
        "initialList=file.read().splitlines()\n",
        "heu = {}\n",
        "graph={}\n",
        "checked = {}\n",
        "rootNode={}\n",
        "print(initialList)\n",
        "\n",
        "#-------------------------------------------------------------------------------#\n",
        "#graph and heuristic table\n",
        "for i in range(len(initialList)):\n",
        "    currentList = initialList[i].split()\n",
        "    #print(currentList)\n",
        "    heu[currentList[0]]=int(currentList[1]) #HEURISTIC DIC READY\n",
        "    graph[currentList[0]]={}\n",
        "    for j in range(2, len(currentList), 2):\n",
        "        graph[currentList[0]][currentList[j]]=int(currentList[j + 1])\n",
        "\n",
        "        #{Arad:{zerind:76,timi;118,sibiy:140},.................} full graph vcreate\n",
        "#------------------------------------------------------------------------------------#\n",
        "\n",
        "source = input('start node:')\n",
        "destination = input('destination:')\n",
        "goal = 'not found'\n",
        "nodeDistance = {}\n",
        "for u in graph:\n",
        "  nodeDistance[u]=float('inf')\n",
        "nodeDistance[source] = 0\n",
        "#print(nodeDistance) #{'Arad': 0, 'Craiova': inf, 'Eforie': inf, 'Fagaras': inf, 'Giurgiu': inf, 'Mehadia': inf, 'Neamt': inf, 'Sibiu'.......}\n",
        "\n",
        "node = [(0, source)]\n",
        "\n",
        "while len(node)!=0:\n",
        "    #print(len(node),node)\n",
        "    currentDistance, u = heapq.heappop(node)\n",
        "    print(currentDistance,u)\n",
        "\n",
        "    if u==destination:\n",
        "        goal = 'found'\n",
        "        break\n",
        "    for v, cost in graph[u].items():\n",
        "        if u != source:\n",
        "            previousDistance = currentDistance - heu[u] #extracting the uptil traversed distance cost\n",
        "            gx = previousDistance + cost\n",
        "        else:\n",
        "           # print(cost)\n",
        "            gx = cost # for the start node just the cost will be included\n",
        "        if v!=destination:\n",
        "            newDistance = gx + heu[v]\n",
        "        else:\n",
        "            newDistance=gx+0\n",
        "        if newDistance < nodeDistance[v]:\n",
        "            nodeDistance[v] = newDistance\n",
        "            rootNode[v]=u\n",
        "            heapq.heappush(node, (newDistance, v))\n",
        "            print(rootNode)\n",
        "if goal == 'found':\n",
        "    tempList = []\n",
        "    x=destination\n",
        "    while x!=source:#visiting the parent nodes to find the shortest path\n",
        "        x=rootNode[x]\n",
        "        tempList.append(x)\n",
        "        print(x)\n",
        "        print(tempList)\n",
        "\n",
        "    #print('Path: ',end='')\n",
        "    for i in range(len(tempList) - 1, -1, -1):#printing the path\n",
        "            print(str(tempList[i]) + ' -> ', end ='')\n",
        "    print(str(destination))\n",
        "    print(f'Total distance: {nodeDistance[destination]} km')\n",
        "\n",
        "else:\n",
        "    print('No Path found')\n",
        "\n",
